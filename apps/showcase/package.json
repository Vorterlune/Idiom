{
  "name": "@idiom/showcase",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "pnpm storybook:generate && tsc --noEmit",
    "bundle": "expo export --platform ios --platform android",
    "storybook": "cross-env STORYBOOK_ENABLED=true expo start --dev-client",
    "storybook:ios": "pnpm storybook --ios",
    "storybook:android": "pnpm storybook --android",
    "storybook:generate": "sb-rn-get-stories --config-path ./.rnstorybook",
    "storybook:bundle": "cross-env STORYBOOK_ENABLED=true STORYBOOK_SERVER=false expo export --platform ios --platform android --output-dir dist/storybook"
  },
  "dependencies": {
    "@expo/ui": "~57.0.23",
    "@gorhom/bottom-sheet": "5.2.14",
    "@idiom/ui": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.28",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "10.6.2",
    "@storybook/addon-ondevice-controls": "10.6.2",
    "@storybook/react-native": "10.6.2",
    "cross-env": "10.1.0",
    "storybook": "10.6.1"
  }
}
